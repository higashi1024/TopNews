---
import fs from "node:fs";
import path from "node:path";
import Base from "../layouts/Base.astro";
// 「今日の話題」で表示している最新日のTOP3(テクノロジー)に出てきた、公的機関などのページだけを並べる
const dir = path.resolve("src/content/topics");
const days = fs.readdirSync(dir).filter((f) => f.endsWith(".json")).map((f) => JSON.parse(fs.readFileSync(path.join(dir, f), "utf8"))).sort((a, b) => b.date.localeCompare(a.date)).slice(0, 5);
const checked = "2026-10-07"; // 出典ページを確認した日
const label = (d) => `${Number(d.slice(5, 7))}月${Number(d.slice(8, 10))}日`;
const sections = days.map((day) => ({
  date: day.date,
  rows: day.items.map((it) => {
    const seen = new Set();
    const links = [];
    for (const b of it.background) {
      if (b.url && !seen.has(b.url)) { seen.add(b.url); links.push({ url: b.url, label: b.label || b.url }); }
    }
    return { title: it.title, links };
  }),
}));
---
<Base title="公的機関の最新情報" description="「今日の話題」のTOP3(テクノロジー)に関連する、公的機関などのページへのリンクです。" noindex={true} hideHeader={true}>
  <p><a href="/topics/">← 今日の話題にもどる</a></p>
  <h1>公的機関の最新情報</h1>
  {sections.map((sec, i) => (
    <section class="day" data-date={sec.date} hidden={i !== 0}>
      <p>{label(sec.date)}のTOP3(テクノロジー)に関連する、公的機関などのページです。内容の詳しい説明は、リンク先の原文でご確認ください。</p>
      <table>
        <thead><tr><th>話題</th><th>公的機関などのページ</th><th>確認日</th></tr></thead>
        <tbody>
          {sec.rows.map((r) => (
            <tr>
              <td>{r.title}</td>
              <td>
                {r.links.length > 0
                  ? <ul>{r.links.map((l) => <li><a href={l.url} rel="noopener">{l.label}</a></li>)}</ul>
                  : <span class="vol">準備中(出典を確認中)</span>}
              </td>
              <td>{checked}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}
  <script is:inline>
    (function () {
      var secs = document.querySelectorAll(".day");
      var want = (location.hash || "").replace("#", "");
      var found = false;
      secs.forEach(function (s) { if (s.dataset.date === want) found = true; });
      if (!found) return;
      secs.forEach(function (s) { s.hidden = s.dataset.date !== want; });
    })();
  </script>
</Base>
