---
import Base from "../../layouts/Base.astro";
import { loadArticles, KEEP, formatDate } from "../../lib/articles.js";
const articles = loadArticles();
---
<Base title="お題の記事" description={`お題をもとに書いた記事の、新しい${KEEP}本の一覧です。`}>
  <h1>お題の記事</h1>
  <p>新しい{KEEP}本を載せています。</p>
  {articles.length === 0 ? <p class="vol">まだ記事はありません。</p> : (
    <ol class="rank">
      {articles.map((a) => (
        <li>
          <a href={`/articles/${a.slug}/`}>{a.title}</a>
          <span class="vol">({formatDate(a.date)}){a.draft ? " 下書き" : ""}</span>
          {a.description && <div class="vol">{a.description}</div>}
        </li>
      ))}
    </ol>
  )}
</Base>
