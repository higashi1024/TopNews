---
import Base from "../../layouts/Base.astro";
import { loadArchive } from "../../lib/data.js";
export function getStaticPaths() {
  return loadArchive().map((d) => ({ params: { date: d.date }, props: { day: d } }));
}
const { day } = Astro.props;
---
<Base share={true} title={`${day.date} のトレンドランキング`} description={`${day.date} のGoogleトレンド急上昇キーワード上位${day.trends.length}件の記録です。`}>
  <h1>{day.date} のトレンドキーワード</h1>
  <p>Googleトレンド(日本)の記録です。</p>
  <ol class="rank">
    {day.trends.map((t) => (
      <li><span class="no">{t.rank}</span><strong>{t.keyword}</strong>
        {t.volume_approx && <span class="vol"> 検索回数の目安:{t.volume_approx}</span>}
        <div class="vol">分類:{t.category}</div>
      </li>
    ))}
  </ol>
  <p><a href="/archive/">一覧にもどる</a></p>
</Base>
